# Hy3 Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Hy3 API Configuration (OpenAI-compatible endpoint)
HY3_BASE_URL=http://127.0.0.1:8000/v1
HY3_API_KEY=your-api-key-here
HY3_MODEL=hy3

# Generation parameters
HY3_REASONING_EFFORT=high
HY3_TEMPERATURE=0.2
HY3_MAX_TOKENS=16384
HY3_TIMEOUT=300

# Dataset configuration
DATASET_NAME=mbppplus
DATASET_SAMPLE_SIZE=30
DATASET_SEED=42

# Execution configuration
EXECUTION_TIMEOUT=30
MAX_WORKERS=4
USE_SANDBOX=true
