# Hy3 Code Process Localizer — Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control (it is gitignored).

# ============================================================
# Provider selection
#   openai       -> OpenAI-compatible endpoint (HY3_BASE_URL + HY3_API_KEY)
#   tencentcloud -> Tencent Cloud Hunyuan service (TENCENTCLOUD_SECRET_ID/KEY)
# ============================================================
HY3_PROVIDER=tencentcloud

# ---- Option A: OpenAI-compatible endpoint (e.g. local vLLM/SGLang) ----
HY3_BASE_URL=http://127.0.0.1:8000/v1
HY3_API_KEY=your-api-key-here

# ---- Option B: Tencent Cloud (live cloud-account credentials) ----
# SECURITY: treat these as highly sensitive. Never commit, print, or log them.
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key

# ---- Model name ----
# openai provider: e.g. hy3
# tencentcloud provider: e.g. hunyuan-turbo / hunyuan-pro / hunyuan-standard
HY3_MODEL=hunyuan-turbo

# Generation parameters (applied where the backend supports them)
HY3_REASONING_EFFORT=high
HY3_TEMPERATURE=0.2
HY3_MAX_TOKENS=16384
HY3_TIMEOUT=300

# Dataset configuration
DATASET_NAME=mbppplus
DATASET_SAMPLE_SIZE=30
DATASET_SEED=42

# Execution configuration
EXECUTION_TIMEOUT=30
MAX_WORKERS=4
USE_SANDBOX=true
